<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Reset password"/></jsp:include><form class="card card-body col-md-5 mx-auto" method="post" action="<c:url value='/reset'/>"><h3>Đặt lại mật khẩu</h3><c:if test="${not empty demoOtp}"><div class="alert alert-info">Mã OTP test: <b>${demoOtp}</b></div></c:if><input class="form-control mb-2" type="email" name="email" value="${param.email}" required><input class="form-control mb-2" name="otp" placeholder="Mã OTP" required><input class="form-control mb-3" type="password" name="password" minlength="6" placeholder="Mật khẩu mới" required><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-primary">Đặt lại mật khẩu</button></form><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
