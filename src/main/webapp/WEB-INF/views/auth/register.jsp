<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Register"/></jsp:include><div class="row justify-content-center"><div class="col-md-6"><form class="card card-body" method="post" action="<c:url value='/register'/>"><h3>Đăng ký</h3><input class="form-control mb-2" name="fullname" placeholder="Họ và tên" required><input class="form-control mb-2" name="username" placeholder="Tên đăng nhập" required><input class="form-control mb-2" type="email" name="email" placeholder="Email" required><input class="form-control mb-3" type="password" name="password" minlength="6" placeholder="Mật khẩu" required><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-primary">Đăng ký</button></form></div></div><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
