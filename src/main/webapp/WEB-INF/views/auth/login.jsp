<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Login"/></jsp:include><div class="row justify-content-center"><div class="col-md-5"><form class="card card-body shadow" method="post" action="<c:url value='/login'/>"><h3>Đăng nhập</h3><c:if test="${param.error != null}"><div class="alert alert-danger">Thông tin đăng nhập không hợp lệ hoặc tài khoản bị khóa.</div></c:if><input class="form-control mb-2" type="email" name="email" placeholder="Email" required><input class="form-control mb-3" type="password" name="password" placeholder="Mật khẩu" required><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-primary">Đăng nhập</button><p class="mt-3 mb-0"><a href="<c:url value='/register'/>">Đăng ký</a> · <a href="<c:url value='/forgot'/>">Quên mật khẩu</a></p></form></div></div><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
