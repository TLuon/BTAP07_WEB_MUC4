<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="OTP"/></jsp:include><div class="row justify-content-center"><div class="col-md-5"><form class="card card-body" method="post" action="<c:url value='/verify'/>"><h3>Xác thực OTP</h3><c:if test="${not empty demoOtp}"><div class="alert alert-info">Mã OTP test: <b>${demoOtp}</b></div></c:if><input class="form-control mb-2" type="email" name="email" value="${param.email}" required><input class="form-control mb-3" name="otp" placeholder="Mã OTP" required><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-primary">Xác thực</button></form></div></div><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
