<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Người dùng"/></jsp:include><h2>Người dùng</h2><form class="row g-2 my-3"><div class="col"><input class="form-control" name="keyword" value="${keyword}" placeholder="Tên đăng nhập, email hoặc họ tên"></div><div class="col-md-2"><select class="form-select" name="role"><option value="">Mọi quyền</option><option value="1">Admin</option><option value="0">User</option></select></div><div class="col-md-2"><select class="form-select" name="status"><option value="">Mọi trạng thái</option><option value="1">Hoạt động</option><option value="0">Khóa</option></select></div><div class="col-md-auto"><button class="btn btn-outline-secondary">Lọc</button></div></form><table class="table bg-white"><tr><th>Username</th><th>Email</th><th>Họ tên</th><th>Quyền</th><th>Trạng thái</th><th></th></tr><c:forEach items="${data.content}" var="x"><tr><td>${x.username}</td><td>${x.email}</td><td>${x.fullname}</td><td>${x.role==1?'Admin':'User'}</td><td>${x.status==1?'Hoạt động':'Khóa'}</td><td><a class="btn btn-sm btn-warning" href="<c:url value='/admin/users/${x.id}/edit'/>">Sửa</a><c:if test="${x.status==1}"><form class="d-inline" method="post" action="<c:url value='/admin/users/${x.id}/lock'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-sm btn-danger">Khóa</button></form></c:if></td></tr></c:forEach></table><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
