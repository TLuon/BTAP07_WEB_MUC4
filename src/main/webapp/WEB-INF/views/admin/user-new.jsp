<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Thêm người dùng"/></jsp:include><form method="post" class="card card-body col-md-6"><h3>Thêm người dùng</h3><input class="form-control mb-2" name="fullname" placeholder="Họ tên" required><input class="form-control mb-2" name="username" placeholder="Tên đăng nhập" required><input class="form-control mb-2" type="email" name="email" placeholder="Email" required><input class="form-control mb-2" type="password" name="password" minlength="6" placeholder="Mật khẩu" required><input class="form-control mb-2" name="phone" placeholder="Số điện thoại"><select class="form-select mb-2" name="role"><option value="0">User</option><option value="1">Admin</option></select><select class="form-select mb-3" name="status"><option value="1">Hoạt động</option><option value="0">Khóa</option></select><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-primary">Tạo</button></form><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
