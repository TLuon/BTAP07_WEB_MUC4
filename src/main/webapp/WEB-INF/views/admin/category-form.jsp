<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Danh mục"/></jsp:include><h2>${empty category.categoryId?'Thêm':'Sửa'} danh mục</h2><form method="post" action="<c:url value='/admin/categories/save'/>" enctype="multipart/form-data" class="card card-body"><c:if test="${not empty category.categoryId}"><input type="hidden" name="id" value="${category.categoryId}"></c:if><label>Tên danh mục</label><input class="form-control mb-3" name="categoryname" value="${category.categoryname}" required><label>Link ảnh</label><input class="form-control mb-3" name="imageUrl" value="${category.images}"><label>Hoặc tải ảnh lên</label><input class="form-control mb-3" type="file" name="imageFile" accept="image/*"><label>Trạng thái</label><select class="form-select mb-3" name="status"><option value="1" ${category.status==1?'selected':''}>Hoạt động</option><option value="0" ${category.status!=1?'selected':''}>Khóa</option></select><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-primary">Lưu</button></form><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
