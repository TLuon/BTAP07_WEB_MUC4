<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Người dùng"/></jsp:include><h2>Cập nhật người dùng</h2><form method="post" action="<c:url value='/admin/users/${managedUser.id}/save'/>" class="card card-body"><label>Username</label><input class="form-control mb-2" name="username" value="${managedUser.username}" required><label>Email</label><input class="form-control mb-2" type="email" name="email" value="${managedUser.email}" required><label>Họ tên</label><input class="form-control mb-2" name="fullname" value="${managedUser.fullname}" required><label>Số điện thoại</label><input class="form-control mb-2" name="phone" value="${managedUser.phone}"><label>Quyền</label><select class="form-select mb-2" name="role"><option value="1" ${managedUser.role==1?'selected':''}>Admin</option><option value="0" ${managedUser.role==0?'selected':''}>User</option></select><label>Trạng thái</label><select class="form-select mb-3" name="status"><option value="1" ${managedUser.status==1?'selected':''}>Hoạt động</option><option value="0" ${managedUser.status==0?'selected':''}>Khóa</option></select><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-primary">Lưu</button></form><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
