<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Sản phẩm"/></jsp:include><div class="d-flex justify-content-between"><h2>Sản phẩm</h2><a class="btn btn-primary" href="<c:url value='/admin/products/new'/>">Thêm sản phẩm</a></div><form class="row g-2 my-3"><div class="col"><input class="form-control" name="keyword" value="${keyword}" placeholder="Tìm theo tên"></div><div class="col-md-2"><select class="form-select" name="status"><option value="">Mọi trạng thái</option><option value="1">Hoạt động</option><option value="0">Khóa</option></select></div><div class="col-md-auto"><button class="btn btn-outline-secondary">Lọc</button></div></form><table class="table bg-white"><tr><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Kho</th><th>Trạng thái</th><th></th></tr><c:forEach items="${data.content}" var="x"><tr><td>${x.productName}</td><td>${x.category.categoryname}</td><td>${x.price}</td><td>${x.stock}</td><td>${x.status==1?'Hoạt động':'Khóa'}</td><td><a class="btn btn-sm btn-warning" href="<c:url value='/admin/products/${x.productId}/edit'/>">Sửa</a><form class="d-inline" method="post" action="<c:url value='/admin/products/${x.productId}/delete'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-sm btn-danger">Xóa</button></form></td></tr></c:forEach></table><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
