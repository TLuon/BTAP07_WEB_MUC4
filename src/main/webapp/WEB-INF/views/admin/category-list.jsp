<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Danh mục"/></jsp:include><div class="d-flex justify-content-between"><h2>Danh mục</h2><a class="btn btn-primary" href="<c:url value='/admin/categories/new'/>">Thêm danh mục</a></div><form class="row g-2 my-3"><div class="col"><input class="form-control" name="keyword" value="${keyword}" placeholder="Tìm theo tên"></div><div class="col-md-2"><select class="form-select" name="status"><option value="">Mọi trạng thái</option><option value="1" ${status==1?'selected':''}>Hoạt động</option><option value="0" ${status==0?'selected':''}>Khóa</option></select></div><div class="col-md-auto"><button class="btn btn-outline-secondary">Lọc</button></div></form><table class="table table-hover bg-white"><tr><th>Ảnh</th><th>Tên</th><th>Trạng thái</th><th></th></tr><c:forEach items="${data.content}" var="x"><tr><td><img src="${x.images.startsWith('http') ? x.images : pageContext.request.contextPath.concat('/uploads/').concat(x.images)}" onerror="this.style.display='none'" width="70"></td><td>${x.categoryname}</td><td>${x.status==1?'Hoạt động':'Khóa'}</td><td><a class="btn btn-sm btn-warning" href="<c:url value='/admin/categories/${x.categoryId}/edit'/>">Sửa</a><form class="d-inline" method="post" action="<c:url value='/admin/categories/${x.categoryId}/delete'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-sm btn-danger" onclick="return confirm('Xóa danh mục?')">Xóa</button></form></td></tr></c:forEach></table><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
