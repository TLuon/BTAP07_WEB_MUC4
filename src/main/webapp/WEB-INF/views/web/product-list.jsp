<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Sản phẩm"/></jsp:include><h2>Sản phẩm</h2><form class="input-group mb-4"><input class="form-control" name="keyword" value="${keyword}" placeholder="Tìm sản phẩm"><button class="btn btn-primary">Tìm</button></form><div class="row g-3"><c:forEach items="${data.content}" var="x"><div class="col-md-4"><div class="card h-100"><div class="card-body"><h5>${x.productName}</h5><p>${x.description}</p><b>${x.price} VNĐ</b><br><a class="btn btn-sm btn-primary mt-2" href="<c:url value='/products/${x.productId}'/>">Chi tiết</a></div></div></div></c:forEach></div><jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>
