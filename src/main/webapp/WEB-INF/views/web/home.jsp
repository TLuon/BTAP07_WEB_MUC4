<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<jsp:include page="/WEB-INF/views/fragments/header.jsp"><jsp:param name="title" value="Trang chủ"/></jsp:include>
<section class="hero mb-5"><div class="row align-items-center"><div class="col-lg-8"><span class="badge text-bg-light text-primary mb-3">MUA SẮM DỄ DÀNG</span><h1 class="display-5 fw-bold">Công nghệ phù hợp cho mỗi ngày của bạn</h1><p class="lead">Khám phá các sản phẩm mới, chất lượng và giá tốt tại IOTStar Shop.</p><a class="btn btn-light text-primary px-4" href="<c:url value='/products'/>">Xem sản phẩm <i class="bi bi-arrow-right ms-1"></i></a></div><div class="col-lg-4 text-center d-none d-lg-block"><i class="bi bi-stars" style="font-size:7rem"></i></div></div></section>
<div class="d-flex align-items-center justify-content-between mb-3"><div><h2 class="page-title mb-1">Sản phẩm mới</h2><span class="text-secondary">Lựa chọn được cập nhật gần đây</span></div><a class="btn btn-outline-primary" href="<c:url value='/products'/>">Xem tất cả</a></div>
<div class="row g-4"><c:forEach items="${products}" var="x"><div class="col-sm-6 col-lg-3"><div class="card product-card"><img class="product-image" src="${x.images}" alt="${x.productName}" onerror="this.src='https://placehold.co/600x400/e2e8f0/64748b?text=IOTStar'"><div class="card-body"><h5 class="fw-bold text-truncate">${x.productName}</h5><p class="price mb-3">${x.price} VNĐ</p><a class="btn btn-outline-primary w-100" href="<c:url value='/products/${x.productId}'/>">Chi tiết</a></div></div></div></c:forEach></div>
<jsp:include page="/WEB-INF/views/fragments/footer.jsp"/>